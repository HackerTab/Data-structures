// 3. QUICK TEST & EDGE CASES
// ==========================================

// ArrayQueue test
const aq = new ArrayQueue(2);
aq.enqueue(10);
aq.enqueue(20);
console.log("ArrayQueue peek:", aq.peek());       // 10
console.log("ArrayQueue dequeue:", aq.dequeue()); // 10

// LinkedListQueue test
const llq = new LinkedListQueue();
llq.enqueue("A");
llq.enqueue("B");
console.log("LinkedListQueue dequeue:", llq.dequeue()); // "A"

// MinHeapPriorityQueue test
const heapPQ = new MinHeapPriorityQueue();
[30, 10, 20].forEach(n => heapPQ.insert(n));
console.log("HeapPQ extractMin:", heapPQ.extractMin()); // 10

// OrderedArrayPriorityQueue test
const arrayPQ = new OrderedArrayPriorityQueue();
[30, 10, 20].forEach(n => arrayPQ.insert(n));
console.log("ArrayPQ extractMin:", arrayPQ.extractMin()); // 10

// Edge case example
try {
  aq.enqueue(30);
  aq.enqueue(40); // Throws "Queue is full"
} catch (err) {
  console.log("Caught expected error:", err.message);
}